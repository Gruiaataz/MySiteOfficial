# Render injects DATABASE_URL automatically when using render.yaml.
DATABASE_URL=postgresql://user:password@localhost:5432/mysiteofficial
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Email verification via Resend (required for real signup confirmation).
# Create a Resend API key and verify a domain for production delivery.
RESEND_API_KEY=
RESEND_FROM=MySiteOfficial <onboarding@resend.dev>

# Where contact requests should be delivered (optional; if omitted, the site still works).
CONTACT_EMAIL=
